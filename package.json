{
  "name": "escala-colegio-militar",
  "version": "1.0.0",
  "description": "Sistema Inteligente de Geração de Escalas para Colégio Militar com Otimização Combinatória",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "prestart": "node -e \"import('node:fs').then(async fs => { if (!fs.existsSync('dist/index.html')) { const { execSync } = await import('node:child_process'); execSync('npm run build', { stdio: 'inherit' }); } })\"",
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "client": "vite --config vite.config.js",
    "build": "vite build",
    "dev": "node server/dev-runner.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "escala",
    "colegio-militar",
    "otimizacao",
    "hungarian-algorithm",
    "escalas-militares"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
